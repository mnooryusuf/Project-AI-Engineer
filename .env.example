APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/agentic_rag

# Koneksi khusus SQL_QUERY tool — role read-only (lihat init.sql), GANTI
# password ini untuk deployment sungguhan.
DATABASE_URL_READONLY=postgresql://agentic_rag_readonly:readonly_agent_pw_2026@localhost:5432/agentic_rag

# Ollama (running on host machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=all-minilm

# Gemini (model kedua, opsional). Kosongkan untuk menonaktifkan pilihan
# Gemini di UI. Kalau dipakai, pertanyaan + riwayat + kutipan dokumen yang
# relevan dikirim ke Google — jangan isi di server yang datanya tidak boleh
# keluar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# File Storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# CORS
CORS_ORIGINS=http://localhost:5173

# JWT Auth
SECRET_KEY=ganti-dengan-secret-key-yang-kuat-minimal-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
